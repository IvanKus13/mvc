@model WebApplication1.Models.Car

@{
    var role = Context.Session.GetString("UserRole");
}

<h2>@Model.Brand @Model.Model</h2>

<p><strong>Рік:</strong> @Model.Year</p>
<p><strong>Ціна:</strong> @Model.Price $</p>
<p><strong>Опис:</strong> @Model.Description</p>

<hr />

<h3>Фотографії</h3>

@if (string.IsNullOrEmpty(Model.ImagePaths))
{
    <p>Фото відсутні.</p>
}
else
{
    var images = Model.ImagePaths.Split(',');

    <div id="carCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < images.Length; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="/images/cars/@images[i]" 
                         class="d-block w-100" 
                         style="max-height:500px; object-fit:contain;">
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
}

<hr />

@if (role == "Admin")
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Видалити</a>
}
