@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MyApp</title>

  
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">

    <header>
       
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">MyApp</a>

                <div>
                    @if (Context.Session.GetString("UserLogin") != null)
                    {
                        <a class="nav-link d-inline text-white" asp-controller="Cars" asp-action="Index">
                            Автомобілі
                        </a>

                        <a class="nav-link d-inline text-white"
                           asp-controller="Cars"
                           asp-action="LinqDemo">
                            LINQ
                        </a>

                        <a class="nav-link d-inline text-white" asp-controller="Orders" asp-action="Index">
                            Замовлення
                        </a>

                        <a class="nav-link d-inline text-white" asp-controller="Auth" asp-action="Logout">
                            Вийти (@Context.Session.GetString("UserLogin"))
                        </a>
                    }
                    
                    else
                    {
                        <a class="nav-link d-inline text-white" asp-controller="Auth" asp-action="Login">Вхід</a>
                        <a class="nav-link d-inline text-white" asp-controller="Auth" asp-action="Register">Реєстрація</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer class="text-center mt-4 mb-3 text-muted">
        <p>&copy; 2025 - MyApp</p>
    </footer>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
